{"cells":[{"value":"### 📓 New Notebook: `analytics_db`\n\n<div style=\"font-size: 12px; background-color: rgba(52, 152, 219, 0.1); border-left: 3px solid #3498db; padding: 6px 10px; margin-bottom: 15px; border-radius: 3px; color: var(--vscode-editor-foreground);\">\n    <strong>ℹ️ Note:</strong> Write and execute your SQL queries in the cell below.\n</div>","kind":"markdown","language":"markdown"},{"value":"SELECT TABLE_NAME \nFROM INFORMATION_SCHEMA.TABLES\nwhere TABLE_SCHEMA = 'athl_v2'\nOrder by 1","kind":"sql","language":"sql"},{"value":"select * from athl_v2.users","kind":"sql","language":"sql"},{"value":"select * from athl_v2.issuer_daily_revenue","kind":"sql","language":"sql"},{"value":"SELECT \n    n.nspname AS schema_name,\n    c.relname AS table_name,\n    reltuples::bigint AS estimated_row_count\nFROM pg_class c\nJOIN pg_namespace n ON n.oid = c.relnamespace\nWHERE n.nspname = 'athl_v2' -- Replace with your schema\n  AND c.relkind = 'r'                -- 'r' denotes ordinary tables\nORDER BY reltuples DESC;","kind":"sql","language":"sql"},{"value":"select MAX(total_revenue)\nfrom athl_v2.tokens","kind":"sql","language":"sql"},{"value":"Select * from athl_v2.tokens where tokens.token_id = 133","kind":"sql","language":"sql"},{"value":"Select tokens.token_id,max(tokens.current_price) from athl_v2.tokens where tokens.token_id = 133 group by 1","kind":"sql","language":"sql"},{"value":"","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1777502154330","host":"localhost","port":5432,"username":"admin","database":"analytics_db","databaseName":"analytics_db","title":"View INFORMATION_SCHEMA.TABLES","custom":{"cells":[{"value":"### 📓 New Notebook: `analytics_db`\n\n<div style=\"font-size: 12px; background-color: rgba(52, 152, 219, 0.1); border-left: 3px solid #3498db; padding: 6px 10px; margin-bottom: 15px; border-radius: 3px; color: var(--vscode-editor-foreground);\">\n    <strong>ℹ️ Note:</strong> Write and execute your SQL queries in the cell below.\n</div>","kind":"markdown","language":"markdown"},{"value":"SELECT TABLE_NAME \nFROM INFORMATION_SCHEMA.TABLES\nwhere TABLE_SCHEMA = 'athl_v2'\nOrder by 1","kind":"sql","language":"sql"},{"value":"select * from athl_v2.users","kind":"sql","language":"sql"},{"value":"select * from athl_v2.issuer_daily_revenue","kind":"sql","language":"sql"},{"value":"SELECT \n    n.nspname AS schema_name,\n    c.relname AS table_name,\n    reltuples::bigint AS estimated_row_count\nFROM pg_class c\nJOIN pg_namespace n ON n.oid = c.relnamespace\nWHERE n.nspname = 'athl_v2' -- Replace with your schema\n  AND c.relkind = 'r'                -- 'r' denotes ordinary tables\nORDER BY reltuples DESC;","kind":"sql","language":"sql"},{"value":"select MAX(total_revenue)\nfrom athl_v2.tokens","kind":"sql","language":"sql"},{"value":"Select * from athl_v2.tokens where tokens.token_id = 133","kind":"sql","language":"sql"},{"value":"Select tokens.token_id,max(tokens.current_price) from athl_v2.tokens where tokens.token_id = 133 group by 1","kind":"sql","language":"sql"},{"value":"","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1777502154330","host":"localhost","port":5432,"username":"admin","database":"analytics_db","databaseName":"analytics_db","title":"View INFORMATION_SCHEMA.TABLES","custom":{"cells":[],"metadata":{"connectionId":"1777502154330","host":"localhost","port":5432,"username":"admin","database":"analytics_db","databaseName":"analytics_db","title":"View INFORMATION_SCHEMA.TABLES","custom":{"cells":[{"value":"### 📓 New Notebook: `analytics_db`\n\n<div style=\"font-size: 12px; background-color: rgba(52, 152, 219, 0.1); border-left: 3px solid #3498db; padding: 6px 10px; margin-bottom: 15px; border-radius: 3px; color: var(--vscode-editor-foreground);\">\n    <strong>ℹ️ Note:</strong> Write and execute your SQL queries in the cell below.\n</div>","kind":"markdown","language":"markdown"},{"value":"SELECT TABLE_NAME \nFROM INFORMATION_SCHEMA.TABLES\nwhere TABLE_SCHEMA = 'athl_v2'\n